{
  "name": "open-flow-launch-film",
  "version": "1.0.0",
  "description": "Open Flow: an 18 second launch film from 8 clips and a headline, rendered in the cloud by Wireflow",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "film": "node film.mjs",
    "film:prepare:block": "node prepare-film-block.mjs",
    "film:assets": "node film-assets.mjs",
    "film:stills": "node film-assets.mjs && node render-film.mjs --stills",
    "film:render": "node film-assets.mjs && node render-film.mjs && node finish-film.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.450",
    "@remotion/renderer": "4.0.450",
    "@sparticuz/chromium": "143.0.4",
    "react": "19.1.2",
    "react-dom": "19.1.2",
    "remotion": "4.0.450"
  },
  "overrides": {
    "remotion": "$remotion"
  }
}
